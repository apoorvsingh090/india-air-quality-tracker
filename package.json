{
  "name": "india-air-quality-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Public India air quality tracker: CPCB AQI, live stations, CAMS, and a Diwali impact study.",
  "homepage": "https://apoorvsingh090.github.io/india-air-quality-tracker/",
  "repository": {
    "type": "git",
    "url": "https://github.com/apoorvsingh090/india-air-quality-tracker.git"
  },
  "scripts": {
    "data": "node scripts/fetch-data.mjs",
    "diwali": "node scripts/diwali.mjs",
    "audit": "node scripts/audit.mjs",
    "test": "node --test",
    "update": "node scripts/fetch-data.mjs && node scripts/diwali.mjs && node scripts/audit.mjs",
    "serve": "npx --yes serve@14 . -l 4173"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "air-quality",
    "aqi",
    "india",
    "cpcb",
    "diwali",
    "open-data"
